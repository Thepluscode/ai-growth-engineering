{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "skill-evaluation-result.v1",
  "description": "What AI Growth Engineering measured about one exact procedure version, returned to the Intelligent Machine as a file. Evidence for a human promotion or review decision; never an approval, never an instruction to act.",
  "type": "object",
  "required": ["contract_version", "contract", "skill_id", "skill_version", "content_hash", "evaluation_type", "evidence_class", "result_class", "use_case", "baseline", "experiment_id", "metrics", "sample", "maturity", "revenue", "confounders", "competing_variables", "includes_synthetic", "unsupported_claims", "market_validation", "decision", "authority", "generated_at", "generated_by"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"type": "string", "const": "1"},
    "contract": {"type": "string", "const": "skill-evaluation-result.v1"},
    "skill_id": {"type": "string"},
    "skill_version": {"type": "string"},
    "content_hash": {"type": "string"},
    "evaluation_type": {"type": "string", "enum": ["OFFLINE_EVAL", "MARKET_EVALUATION"]},
    "evidence_class": {"type": "string", "enum": ["OFFLINE_EVAL", "CONTROLLED_MARKET_EXPERIMENT", "OBSERVATIONAL_MARKET_RESULT"]},
    "result_class": {"type": "string", "enum": ["CONTROLLED_EFFECT", "DESCRIPTIVE_DIFFERENCE", "CONFOUNDED", "INSUFFICIENT_SAMPLE", "IMMATURE", "NO_DIFFERENCE", "REGRESSION", "NOT_EVALUABLE"]},
    "use_case": {"type": "string"},
    "baseline": {
      "type": "object",
      "required": ["procedure_ref", "content_hash"],
      "properties": {
        "procedure_ref": {"type": "string"},
        "content_hash": {"type": ["string", "null"]},
        "source_ref": {"type": "string"}
      }
    },
    "experiment_id": {"type": ["string", "null"]},
    "metrics": {"type": "object"},
    "sample": {"type": "object"},
    "maturity": {"type": "object"},
    "revenue": {
      "type": "object",
      "required": ["claim"],
      "properties": {
        "claim": {"type": "string", "enum": ["NONE_OBSERVED", "ASSOCIATED_ONLY", "ATTRIBUTED", "CAUSAL_SUPPORTED"]}
      }
    },
    "confounders": {"type": "array", "items": {"type": "string"}},
    "competing_variables": {"type": "array", "items": {"type": "string"}},
    "includes_synthetic": {"type": "boolean"},
    "unsupported_claims": {"type": "array", "items": {"type": "string"}},
    "market_validation": {"type": "boolean"},
    "decision": {"type": "string", "enum": ["KEEP", "ITERATE", "REJECT", "NEED_MORE_DATA"]},
    "authority": {"type": "string", "const": "RECOMMENDATION_ONLY"},
    "reviewer": {"type": "string"},
    "limitations": {"type": "string"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "generated_at": {"type": "string"},
    "generated_by": {"type": "string"}
  }
}
